{
  "info": {
    "name": "Rest House Order API – workflow validation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run with tests/run-postman.php for isolated fixtures and DB verification. Manual execution requires fixture values documented in docs/order-api.md."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "table_id",
      "value": ""
    },
    {
      "key": "meal_id",
      "value": ""
    },
    {
      "key": "drink_id",
      "value": ""
    },
    {
      "key": "snack_id",
      "value": ""
    },
    {
      "key": "extra_id",
      "value": ""
    },
    {
      "key": "raw_id",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "order_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set(\"token\", json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "1 Create mixed order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"table_id\": \"{{table_id}}\",\n  \"chairs_count\": 2,\n  \"items\": [\n    {\n      \"product_id\": \"{{meal_id}}\",\n      \"quantity\": \"2\",\n      \"note\": \"بدون ملح\"\n    },\n    {\n      \"product_id\": \"{{drink_id}}\",\n      \"quantity\": \"3\"\n    },\n    {\n      \"product_id\": \"{{snack_id}}\",\n      \"quantity\": \"1\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set(\"order_id\", json.data.id);",
              "pm.test(\"data.total_amount\", () => pm.expect(json.data.total_amount).to.eql(\"61.80\"));",
              "pm.test(\"data.order_status\", () => pm.expect(json.data.order_status).to.eql(\"PENDING_APPROVAL\"));",
              "pm.test(\"Daily order number\", () => pm.expect(json.data.order_number).to.match(/^ORD-\\d{8}-\\d{4}$/));"
            ]
          }
        }
      ]
    },
